# karl-twin environment. Copy to .env (gitignored) and fill in.
# Auto-generated values (QDRANT_API_KEY, POSTGRES_PASSWORD) populated by:
#   python -m karl_twin.admin generate_env

# ---- Required: user-supplied ----
ANTHROPIC_API_KEY=
E2B_API_KEY=

# ---- Auto-generated by admin generate_env (do not hand-edit) ----
QDRANT_API_KEY=
POSTGRES_PASSWORD=

# ---- Service URLs ----
QDRANT_URL=http://localhost:6333
POSTGRES_URL=postgresql://karl:CHANGEME@localhost:5432/karltwin

# ---- Paths ----
OUTPUT_DIR=C:\karl-twin\data\outputs
EVENT_DB_PATH=C:\karl-twin\data\events.db

# ---- Server ----
KARL_TWIN_API_HOST=0.0.0.0
KARL_TWIN_API_PORT=8000

# ---- Models ----
KARL_TWIN_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SEC=120
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# ---- Confidence threshold for clarify routing ----
CONFIDENCE_THRESHOLD=0.7

# ---- Owner identity ----
OWNER_NAME=Karl
