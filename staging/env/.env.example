# KarLux / Palm Springs Paradise — local secrets template
# Copy to repo root: cp staging/env/.env.example .env
# NEVER commit .env

# --- Supabase (Manus / backend) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=only-on-server-never-in-roblox-client
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# --- Roblox Open Cloud / Tarmac (Manus) ---
# ROBLOX_API_KEY=
# TARMAC_AUTH=

