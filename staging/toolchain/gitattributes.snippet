# Append to repo .gitattributes on merge (enable: git lfs install)

vendor-imports/**/*.fbx filter=lfs diff=lfs merge=lfs -text
vendor-imports/**/*.blend filter=lfs diff=lfs merge=lfs -text
vendor-imports/**/*.png filter=lfs diff=lfs merge=lfs -text
vendor-imports/**/*.jpg filter=lfs diff=lfs merge=lfs -text
vendor-imports/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
vendor-imports/**/*.wav filter=lfs diff=lfs merge=lfs -text
vendor-imports/**/*.mesh filter=lfs diff=lfs merge=lfs -text
