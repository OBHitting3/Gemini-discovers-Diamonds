{
  "name": "MulletGame",
  "tree": {
    "$className": "DataModel",

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/server"
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/client"
      }
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$path": "src/shared"
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "ClockTime": 14,
        "Brightness": 2,
        "GlobalShadows": true
      }
    },

    "SoundService": {
      "$className": "SoundService"
    },

    "Chat": {
      "$className": "Chat"
    }
  },

  "globIgnorePaths": [
    "**/*.md",
    "node_modules"
  ]
}
